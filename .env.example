# Copy to .env and fill in before running `docker compose up`.

# Required. Generate a strong secret of at least 32 characters:
#   openssl rand -base64 48
# The server refuses to start without one.
JWT_SECRET=

POSTGRES_PASSWORD=gitforge_dev

# Only the Vite dev server needs this. Through nginx the browser makes
# same-origin requests and no preflight happens at all. Set it when the frontend
# is deployed somewhere other than beside the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Where the browser should look for the API. Relative by default, because nginx
# proxies /api to the server. Vite inlines this at BUILD time, so changing it
# requires rebuilding the frontend image.
VITE_API_BASE_URL=/api/v1

# Host port for the application. Change if something already owns port 80.
FRONTEND_PORT=80

# --- Demo data (docker-compose.demo.yml only) --------------------------------
# The overlay is what makes these do anything; on their own they are inert.
#
# The password every seeded account is given.
DEMO_PASSWORD=gitforge-demo-2026
#
# Leave empty to date the dataset from now, so contribution calendars look
# alive. Pin it to an ISO instant - 2026-01-01T00:00:00Z - and the dataset is
# reproducible byte for byte, object ids included.
DEMO_EPOCH=
