<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  Spring Boot is the parent of the aggregate rather than of one module, so
	  every module resolves the same managed versions. Inheriting it costs the
	  engine nothing: dependencyManagement declares versions, it does not add
	  jars, and the engine module below declares no Spring dependency at all.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>com.gitforge</groupId>
	<artifactId>gitforge</artifactId>
	<version>2.0.17</version>
	<packaging>pom</packaging>
	<name>gitforge</name>
	<description>GitForge: a GitHub-style application backed by a version control engine written from first principles</description>

	<!--
	  Three modules, and the dependency arrows only ever point one way:

	      engine  ←  server
	         ↑
	         └────  cli

	  The engine is the version control implementation and knows nothing about
	  HTTP, persistence or Spring. The server serves it over the web. The cli
	  drives it locally and talks to a server over HTTP for everything the
	  server owns — and depends on the server module not at all, so a command
	  line tool does not need a database driver on its classpath to start.
	-->
	<modules>
		<module>engine</module>
		<module>server</module>
		<module>cli</module>
	</modules>

	<properties>
		<java.version>21</java.version>
		<jjwt.version>0.12.6</jjwt.version>

		<!--
		  Advisories across managed versions, ahead of the Spring Boot release
		  that carries the fixes.

		  Each is a patch release inside the range this project already manages,
		  so the override raises a version rather than choosing a different one,
		  and it disappears the moment the parent catches up.

		  The two Jackson properties name whole BOMs, not single artifacts:
		  databind, core and annotations move together, which is the only way
		  they are supported.

		  These are now found rather than noticed: tools/dependency_scan.py runs
		  in CI, asks OSV.dev about every resolved artifact, and fails the build
		  on anything outstanding. Every version below is here because that scan
		  named it.
		-->

		<!-- GHSA-j92g-9f8w-j867: channel binding could be dropped without saying so. -->
		<postgresql.version>42.7.12</postgresql.version>

		<!--
		  CVE-2026-65182, CVE-2026-68525 and CVE-2026-65905: three critical
		  advisories against the embedded servlet container, all fixed in
		  11.0.25.

		  None of the three is reachable as this application is configured. Two
		  need Tomcat's own DIGEST or FORM authenticators, and GitForge
		  authenticates in a Spring Security filter with a bearer token; the
		  third bypasses <security-constraint> elements, and this application
		  declares none, because authorization lives in the service layer.

		  Bumped anyway, and the analysis is not the reason to skip it. This is
		  the component that terminates every request, the fix is a patch inside
		  the minor version already in use, and the argument for leaving it is an
		  argument that depends on configuration nobody promised not to change.
		-->
		<tomcat.version>11.0.25</tomcat.version>

		<!--
		  CVE-2026-49844: a MapMessage holding NaN or Infinity serialises to
		  something that is not valid JSON.

		  Reachable only through the JSON template layout's message resolver, and
		  this application logs through Logback - log4j-api is present only
		  because the starter bridges it to SLF4J, and MapMessage.asJson is never
		  called. A patch release costs less than the exception would.
		-->
		<log4j2.version>2.25.5</log4j2.version>

		<!-- GHSA-5gvw-p9qm-jgwh, and the @JsonView and @JsonIgnoreProperties
		     bypasses alongside it. This codebase uses none of those annotations,
		     so nothing here was reachable; the bump costs a line and removes the
		     question. -->
		<jackson-bom.version>3.1.5</jackson-bom.version>
		<jackson-2-bom.version>2.21.5</jackson-2-bom.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.gitforge</groupId>
				<artifactId>engine</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.gitforge</groupId>
				<artifactId>engine</artifactId>
				<version>${project.version}</version>
				<type>test-jar</type>
				<scope>test</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<plugins>
			<!-- Integration tests (*IT) run in the verify phase, separate from unit tests. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
